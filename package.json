{
  "name": "dolgers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "npm --prefix apps/web test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dolgers \"node --test firebase/tests/*.test.mjs\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-dolgers"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1"
  }
}
