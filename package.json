{
  "name": "dolgers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/pipeline"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dolgers \"node --test firebase/tests/*.test.mjs\"",
    "emulators": "firebase emulators:start --only firestore --project demo-dolgers",
    "pipeline": "npm run start -w @dolgers/pipeline --"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "typescript": "^5.9.3"
  }
}
