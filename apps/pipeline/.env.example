# AliExpress Open Platform app (Dropshipping)
AE_APP_KEY=
AE_APP_SECRET=
# Only for --dry-run (no database to store tokens in):
# AE_ACCESS_TOKEN=
# AE_REFRESH_TOKEN=
# AE_EXPIRES_AT=

# Claude API key for review analysis, image checks, size charts and listings
ANTHROPIC_API_KEY=
# Optional model overrides
# AI_MODEL_FAST=claude-sonnet-5-5
# AI_MODEL_CAREFUL=claude-opus-5-5

# Firebase project; credentials come from Application Default Credentials
# (gcloud auth application-default login) or a service account JSON string:
GCLOUD_PROJECT=dolgers-staging
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
