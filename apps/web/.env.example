# Copy to .env.local. With nothing set, the site runs on the bundled demo catalog (read-only).

# Point at the Firebase emulators (run `npm run emulators` and `npm run seed` from the repo root).
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-dolgers
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-dolgers.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-dolgers.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GOOGLE_CLOUD_PROJECT=demo-dolgers

NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Stripe test publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Typesense. Without it, search falls back to filtering the catalog in memory.
TYPESENSE_HOST=
TYPESENSE_SEARCH_KEY=

REVALIDATE_SECRET=dev-revalidate-secret
