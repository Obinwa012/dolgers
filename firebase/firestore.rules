rules_version = '2';

// The pipeline writes everything with the Admin SDK, which bypasses these rules.
// Clients may only read live products; admins (custom claim `admin: true`) may read
// the review queue and decision records. Nothing is client-writable yet.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow get, list: if resource.data.status == 'live' || isAdmin();
      allow write: if false;
    }

    match /sourcing/{id} { allow read: if isAdmin(); allow write: if false; }
    match /vetting/{id} { allow read: if isAdmin(); allow write: if false; }
    match /sellers/{id} { allow read: if isAdmin(); allow write: if false; }
    match /candidates/{id} { allow read: if isAdmin(); allow write: if false; }
    match /runs/{id} { allow read: if isAdmin(); allow write: if false; }

    // config/aliexpress holds API tokens: never readable from a client, admin or not.
    match /config/{doc} {
      allow read: if isAdmin() && doc != 'aliexpress';
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
