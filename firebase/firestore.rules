rules_version = '2';

// The admin dashboard reads and writes Firestore only from its server, with the Admin SDK, which
// bypasses these rules. Browsers get no direct access except to read live products (for a future
// storefront or feed). In particular, config/secrets (API keys and tokens), users (the admin flag),
// sessions, oauth_states, jobs and work are never reachable from a client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow get, list: if resource.data.status == 'live';
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
