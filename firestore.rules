rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Public catalog: anyone can read, only admins (custom claim) or the Admin SDK seed script can write.
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /posts/{id}      { allow read: if true; allow write: if isAdmin(); }

    // Per-user profile, cart and wishlist.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Orders are created and updated only by the server (/api/checkout and the Stripe webhook,
    // via the Admin SDK, which bypasses these rules). Clients may read their own.
    // Letting clients create orders meant they could write any price, total or status.
    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update, delete: if isAdmin(); // e.g. a future admin dashboard marking orders shipped
    }

    // Newsletter: write-only from the client, with basic validation.
    match /subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.email == email          // doc id must be the address
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.createdAt == request.time; // serverTimestamp() only
      allow read, update, delete: if isAdmin();
    }
  }
}
